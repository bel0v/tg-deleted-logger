[Unit]
Description=Telegram deleted-message logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tglogger
WorkingDirectory=/opt/tg-logger
ExecStart=/usr/bin/node dist/index.js
LoadCredentialEncrypted=tg-session:/etc/credstore.encrypted/tg-session
EnvironmentFile=/etc/tg-logger.env
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tg-logger/data

[Install]
WantedBy=multi-user.target
