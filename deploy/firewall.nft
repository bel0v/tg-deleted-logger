#!/usr/sbin/nft -f
#
# nftables config for the userbot host.
#
# Strategy: lock outbound *for the tglogger user only* to Telegram's DC IP
# ranges + DNS. Root and any deploy user keep normal outbound so npm ci,
# git pull, etc. still work. An attacker who lands in the userbot process
# cannot exfiltrate to anywhere other than Telegram itself.
#
# Telegram DC ranges sourced from https://core.telegram.org/resources/cidr.txt
# These have been stable since ~2018; refresh periodically.
#
# Apply once:
#   sudo cp deploy/firewall.nft /etc/nftables.conf
#   sudo systemctl enable --now nftables
#
# Reload after editing:
#   sudo nft -f /etc/nftables.conf

flush ruleset

table inet filter {
	set telegram_v4 {
		type ipv4_addr
		flags interval
		elements = {
			91.105.192.0/23,
			91.108.4.0/22,
			91.108.8.0/22,
			91.108.12.0/22,
			91.108.16.0/22,
			91.108.56.0/22,
			149.154.160.0/20,
			95.161.64.0/20,
		}
	}

	chain input {
		type filter hook input priority 0; policy drop;
		ct state established,related accept
		iif lo accept
		ip protocol icmp accept
		ip6 nexthdr icmpv6 accept
		tcp dport 22 accept comment "SSH — restrict by source IP if you can"
		counter drop
	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy drop;
		ct state established,related accept
		oif lo accept

		# tglogger: Telegram + DNS only. Process compromise cannot exfiltrate elsewhere.
		skuid tglogger udp dport 53 accept
		skuid tglogger tcp dport 53 accept
		skuid tglogger ip daddr @telegram_v4 tcp dport { 80, 443, 5222 } accept
		skuid tglogger counter drop comment "tglogger: deny non-Telegram"

		# Everyone else (root, deploy user, your SSH session): normal outbound.
		udp dport 53 accept
		tcp dport 53 accept
		udp dport 123 accept comment "NTP"
		tcp dport 22 accept
		tcp dport { 80, 443 } accept
	}
}
