{
	"name": "tg-deleted-logger",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"login": "tsx src/login.ts",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test \"src/**/*.test.ts\"",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check --write",
		"verify": "biome check && tsc --noEmit",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run verify",
		"pre-push": "npm run test"
	},
	"dependencies": {
		"dotenv": "17.4.2",
		"pino": "10.3.1",
		"telegram": "2.26.22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "25.9.3",
		"pino-pretty": "13.1.3",
		"simple-git-hooks": "2.13.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	}
}
