{
	"name": "tg-deleted-logger",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"login": "tsx src/login.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check --write"
	},
	"dependencies": {
		"dotenv": "17.4.2",
		"telegram": "2.26.22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "25.9.3",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	}
}
