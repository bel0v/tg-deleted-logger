# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Only used for local non-systemd runs. In production, the session is mounted
# via systemd LoadCredentialEncrypted and read from $CREDENTIALS_DIRECTORY.
TG_SESSION=

# Optional. Default 90. Messages and revisions older than this are purged daily.
# Bounds the data an attacker gets from a compromised host.
TG_RETENTION_DAYS=
