# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Only used for local non-systemd runs. In production, the session is mounted
# via systemd LoadCredentialEncrypted and read from $CREDENTIALS_DIRECTORY.
TG_SESSION=

# Where to send notifications. Defaults to "me" (your own Saved Messages).
# For a dedicated private channel, use its numeric ID (e.g. -1001234567890).
# Public channels work via "@channel_username".
TG_NOTIFY_CHAT_ID=

# Where downloaded media is stored. Defaults to "data/media" relative to cwd.
# Override on the server to "/opt/tg-logger/data/media".
TG_MEDIA_DIR=

# Optional. Defaults to 1 (24h). In-memory cache entries and on-disk media
# files older than this are purged daily.
TG_RETENTION_DAYS=

# Optional. Defaults to 600000 (10 min). How often the reconciler scans
# Telegram for silent deletions.
TG_RECONCILE_INTERVAL_MS=

# Optional. Defaults to "info". One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=
